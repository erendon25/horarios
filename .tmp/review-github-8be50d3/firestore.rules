rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // MODELO HEREDADO RELEVANTE PARA AUTORIZACIÓN
    // ===============================================================
    // users/{uid}: role, storeId y staffProfileId son atributos de acceso.
    // schedules/{staffProfileId}_{weekKey}: storeId identifica la tienda;
    // uid/staffId pueden existir en documentos más recientes, pero el ID del
    // documento es la identidad estable usada por los horarios heredados.

    // ========================
    // FUNCIONES DE APOYO
    // ========================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == "admin";
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == "superadmin";
    }

    function getUserStoreId() {
      return getUserData().storeId;
    }

    function isTrainer() {
      return isAuthenticated() && getUserData().role == "trainer";
    }

    function hasLinkedStaffProfile() {
      let profileId = getUserData().staffProfileId;
      return isAuthenticated() &&
        profileId is string &&
        profileId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') &&
        exists(/databases/$(database)/documents/staff_profiles/$(profileId)) &&
        get(/databases/$(database)/documents/staff_profiles/$(profileId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/staff_profiles/$(profileId)).data.storeId == getUserStoreId();
    }

    function isOwnSchedule(docId) {
      return hasLinkedStaffProfile() && (
        docId == getUserData().staffProfileId ||
        docId.matches('^' + getUserData().staffProfileId + '_.+$')
      );
    }

    function canReadStoreSchedules(storeId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        storeId == getUserStoreId() &&
        (isAdmin() || isTrainer())
      );
    }

    function legacyScheduleChangesAllowed() {
      let lockPath = /databases/$(database)/documents/stores/$(getUserStoreId())/config/schedule_lock;
      return !exists(lockPath) ||
        get(lockPath).data.restrictionsEnabled != true;
    }

    // ========================
    // PERFILES DE PERSONAL
    // ========================
    match /staff_profiles/{profileId} {
      // Cualquier usuario autenticado puede leer perfiles no vinculados (uid == null)
      // para poder usar el flujo de "Vincular cuenta". Los perfiles vinculados solo los
      // puede leer el admin de la tienda, el trainer, o el propio colaborador.
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (isAdmin() && resource.data.storeId == getUserStoreId()) ||
          (isTrainer() && resource.data.storeId == getUserStoreId()) ||
          (resource.data.uid == request.auth.uid) ||
          (!('uid' in resource.data)) ||
          (resource.data.uid == null) ||
          (resource.data.uid == "")
        )
      );
      // Solo Admin/SuperAdmin de la misma tienda crean o eliminan.
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.storeId == getUserStoreId());
      
      // Update: Admin conserva la tienda. Trainer solo cambia skills. El
      // colaborador no puede reclamar perfiles sueltos ni cambiar identidad,
      // posición o tienda desde el cliente.
      allow update: if isSuperAdmin() || 
                    (isAdmin() &&
                      resource.data.storeId == getUserStoreId() &&
                      request.resource.data.storeId == getUserStoreId()) ||
                    (isTrainer() &&
                      resource.data.storeId == getUserStoreId() &&
                      request.resource.data.storeId == getUserStoreId() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['skills'])) ||
                    (isAuthenticated() &&
                      hasLinkedStaffProfile() &&
                      profileId == getUserData().staffProfileId &&
                      resource.data.uid == request.auth.uid &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['birthDate', 'pendingHolidays', 'updatedAt']) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingHolidays']) ||
                        legacyScheduleChangesAllowed()));
      
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId());
    }

    // ========================
    // HORARIOS GENERADOS (Schedules)
    // ========================
    match /schedules/{docId} {
      // Un colaborador solo ve su propio documento. Los responsables leen
      // únicamente horarios con el storeId de su tienda. Los documentos
      // heredados sin storeId quedan deliberadamente cerrados para terceros.
      allow read: if isSuperAdmin() ||
        isOwnSchedule(docId) ||
        (('storeId' in resource.data) &&
          canReadStoreSchedules(resource.data.storeId));

      allow create: if isSuperAdmin() || (
        isAdmin() && request.resource.data.storeId == getUserStoreId()
      );
      allow update: if isSuperAdmin() || (
        isAdmin() &&
        resource.data.storeId == getUserStoreId() &&
        request.resource.data.storeId == getUserStoreId()
      );
      allow delete: if isSuperAdmin() || (
        isAdmin() && resource.data.storeId == getUserStoreId()
      );
    }

    // ========================
    // FERIADOS TRABAJADOS (Balance)
    // ========================
    match /feriados_trabajados/{docId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (isAdmin() && resource.data.storeId == getUserStoreId()) ||
          (isTrainer() && resource.data.storeId == getUserStoreId()) ||
          (resource.data.uid == request.auth.uid)
        )
      );
      allow create, update, delete: if isSuperAdmin() || isAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }
    
    // Alias por compatibilidad
    match /worked_holidays/{docId} {
      allow read, write: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId()) || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ========================
    // HORARIOS DE ESTUDIO
    // ========================
    match /study_schedules/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin() || isSuperAdmin() || isTrainer());
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin() || isSuperAdmin());
    }

    // ========================
    // HORAS EXTRAS
    // ========================
    match /extra_hours/{docId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (isAdmin() && resource.data.storeId == getUserStoreId()) ||
          (isTrainer() && resource.data.storeId == getUserStoreId()) ||
          (resource.data.uid == request.auth.uid)
        )
      );
      allow write: if isSuperAdmin() || isAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // ========================
    // HISTORIAL DE CESES
    // ========================
    match /ceses/{docId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId());
      allow create, update: if isSuperAdmin() || (isAdmin() && request.resource.data.storeId == getUserStoreId());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId());
    }

    // ========================
    // REQUERIMIENTOS Y TIENDAS
    // ========================
    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /stores/{storeId}/positioning_requirements/{docId} {
      // Cualquier autenticado puede leer (colaboradores lo necesitan para ver/editar skills)
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdmin() && storeId == getUserStoreId());
    }

    match /stores/{storeId}/config/{docId} {
      // Cualquier autenticado puede leer la config (lock schedule, etc.)
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdmin() && storeId == getUserStoreId());
    }

    match /stores/{storeId}/sales_config/{docId} {
      // Cualquier autenticado puede leer la configuración de ventas de la tienda
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdmin() && storeId == getUserStoreId());
    }

    match /positioning_requirements/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ========================
    // USUARIOS (Cuentas de acceso)
    // ========================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isSuperAdmin() || isTrainer());
      // El usuario puede mantener datos de presentación, pero no los atributos
      // que conceden acceso (role, storeId, staffProfileId o status).
      allow update: if isSuperAdmin() ||
                    (isAdmin() &&
                      resource.data.storeId == getUserStoreId() &&
                      request.resource.data.storeId == getUserStoreId() &&
                      request.resource.data.role in ['collaborator', 'trainer', 'admin']) ||
                    (isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'lastName', 'email', 'updatedAt']));
      // El autorregistro siempre nace sin privilegios ni vínculo elegido por
      // el cliente. La vinculación canónica la realiza un responsable.
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == "collaborator" &&
        (!('staffProfileId' in request.resource.data) ||
          request.resource.data.staffProfileId == null ||
          request.resource.data.staffProfileId == "")
      );
      allow delete: if isSuperAdmin();
    }

    // ========================
    // EVALUACIONES DE ENTRENAMIENTO
    // ========================
    match /training_evaluations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        isAuthenticated() && (
          isAdmin() || isTrainer()
        )
      );
    }

    // ========================
    // SOLICITUDES DE HORARIO
    // ========================
    match /schedule_requests/{docId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (isAdmin() && resource.data.storeId == getUserStoreId()) ||
          (isTrainer() && resource.data.storeId == getUserStoreId()) ||
          (resource.data.uid == request.auth.uid)
        )
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        isAdmin() || 
        (request.resource.data.uid == request.auth.uid)
      );
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.storeId == getUserStoreId());
    }

    // ========================
    // REGLA POR DEFECTO
    // ========================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
